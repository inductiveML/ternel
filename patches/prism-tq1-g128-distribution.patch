+    for (int ib = 0; ib < nb; ++ib) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[ib].d);
+        float sumi = 0.0f;
+        for (int k = 0; k < 4; ++k) {
+            const block_q8_0 * GGML_RESTRICT yb = &y[ib * 4 + k];
+            const float d1 = GGML_CPU_FP16_TO_FP32(yb->d);
+            int sumi_block = 0;
+            for (int j = 0; j < 32; ++j) {
+                const int logical = 32 * k + j;
+                const int trit = logical < 125
+                    ? (x[ib].qs[logical / 5] / powers[logical % 5]) % 3
+                    : (x[ib].qs[25] / powers[logical - 125]) % 3;
+                sumi_block += (trit - 1) * yb->qs[j];
+            }
+            sumi += d1 * sumi_block;
+        }
+        sumf += d0 * sumi;
+    }
+
+    *s = sumf;
+}
