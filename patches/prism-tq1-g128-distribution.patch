+template<typename dst_t>
+static __global__ void k_get_rows_tq1_g128(
+        const uint8_t * __restrict__ codes, const int32_t * __restrict__ src1, dst_t * __restrict__ dst,
+        const int64_t ne00, const int64_t ne01, const int64_t ne11, const uint3 ne12_fdv,
+        const size_t s1, const size_t s2, const size_t s3,
+        const size_t s10, const size_t s11, const size_t s12) {
+    constexpr int m_tile = 256;
+    constexpr int code_slots = 26;
+    const int64_t groups = ne00 / QK_TQ1_G128;
+    const int64_t padded_rows = ((ne01 + m_tile - 1) / m_tile) * m_tile;
+    const half * scales = (const half *) (codes + padded_rows * groups * code_slots);
+
+    for (int64_t z = blockIdx.z; z < ne11 * (int64_t) ne12_fdv.z; z += gridDim.z) {
+        for (int64_t i00 = blockIdx.y * blockDim.x + threadIdx.x;
+                i00 < ne00; i00 += gridDim.y * blockDim.x) {
+            const int i10 = blockIdx.x;
+            const uint2 dm = fast_div_modulo((uint32_t) z, ne12_fdv);
+            const int i11 = dm.x;
+            const int i12 = dm.y;
+            const int i01 = src1[i10 * s10 + i11 * s11 + i12 * s12];
+            if (i01 < 0 || i01 >= ne01) {
+                continue;
+            }
+
+            const int group = i00 / QK_TQ1_G128;
+            const int logical = i00 - group * QK_TQ1_G128;
+            const int slot = logical < 125 ? logical / 5 : 25;
+            const int digit = logical < 125 ? logical % 5 : logical - 125;
+            const int power = digit == 0 ? 1 : digit == 1 ? 3 : digit == 2 ? 9 : digit == 3 ? 27 : 81;
+            const int tile = i01 / m_tile;
+            const int row = i01 - tile * m_tile;
+            const size_t code_index =
+                ((size_t) tile * groups + group) * code_slots * m_tile + slot * m_tile + row;
+            const size_t scale_index = ((size_t) tile * groups + group) * m_tile + row;
+            const int trit = (codes[code_index] / power) % 3;
