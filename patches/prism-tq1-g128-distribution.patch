diff --git a/ggml/src/ggml-cuda/tq1-g128.cu b/ggml/src/ggml-cuda/tq1-g128.cu
new file mode 100644
index 00000000..bb02ef4b
--- /dev/null
+++ b/ggml/src/ggml-cuda/tq1-g128.cu
@@ -0,0 +1,285 @@
+#include "tq1-g128.cuh"
+
+#include "quantize.cuh"
+
+#include <cstddef>
+
+namespace {
+
+constexpr int TQ1_M_TILE = 256;
+constexpr int TQ1_CODE_SLOTS = 26;
+constexpr int TQ1_FULL_SLOTS = 25;
+constexpr int TQ1_K_CHUNK = 512;
+
+struct alignas(128) tq1_lut_buffer {
+    alignas(128) float l2[TQ1_FULL_SLOTS][32];
+    alignas(128) float l3[TQ1_FULL_SLOTS][32];
+    alignas(128) float tail[32];
+};
+
+static_assert(sizeof(tq1_lut_buffer) % 128 == 0, "tq1 LUT alignment");
+static_assert(offsetof(tq1_lut_buffer, l2) % 128 == 0, "tq1 L2 alignment");
+static_assert(offsetof(tq1_lut_buffer, l3) % 128 == 0, "tq1 L3 alignment");
+static_assert(offsetof(tq1_lut_buffer, tail) % 128 == 0, "tq1 tail alignment");
+
+__device__ __forceinline__ float tq1_load_q8(
+        const block_q8_1 * __restrict__ activation,
+        const int logical) {
+    const block_q8_1 & block = activation[logical >> 5];
+    return __half2float(block.data.d) * static_cast<float>(block.qs[logical & 31]);
+}
+
+__device__ __forceinline__ void tq1_build_lut(
+        const block_q8_1 * __restrict__ activation,
+        const int group,
+        const float trit0,
+        const float trit1,
+        const float trit2,
+        tq1_lut_buffer & lut) {
+    const int tid  = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+
+    const int first_slot = warp == 0 ? 0 : 4 + (warp - 1) * 3;
+    const int slot_count = warp == 0 ? 4 : 3;
+    const int activation_count = 5 * slot_count + (warp == 7 ? 3 : 0);
+    const int first_logical = group * QK_TQ1_G128 + 5 * first_slot;
+    const float x = lane < activation_count
+        ? tq1_load_q8(activation, first_logical + lane)
+        : 0.0f;
+
+#pragma unroll
+    for (int local_slot = 0; local_slot < 4; ++local_slot) {
+        if (local_slot >= slot_count) {
+            break;
+        }
+        const int slot = first_slot + local_slot;
+        const int source = 5 * local_slot;
+        const float x0 = __shfl_sync(0xffffffffu, x, source + 0);
+        const float x1 = __shfl_sync(0xffffffffu, x, source + 1);
+        const float x2 = __shfl_sync(0xffffffffu, x, source + 2);
+        const float x3 = __shfl_sync(0xffffffffu, x, source + 3);
+        const float x4 = __shfl_sync(0xffffffffu, x, source + 4);
+        if (lane < 9) {
+            lut.l2[slot][lane] = trit0 * x0 + trit1 * x1;
+        }
+        if (lane < 27) {
+            lut.l3[slot][lane] = trit0 * x2 + trit1 * x3 + trit2 * x4;
+        }
+    }
+
+    if (warp == 7) {
+        const float x0 = __shfl_sync(0xffffffffu, x, 15);
+        const float x1 = __shfl_sync(0xffffffffu, x, 16);
+        const float x2 = __shfl_sync(0xffffffffu, x, 17);
+        if (lane < 27) {
+            lut.tail[lane] = trit0 * x0 + trit1 * x1 + trit2 * x2;
+        }
+    }
+    __syncthreads();
+}
+
+__device__ __forceinline__ float tq1_consume_code(
+        const tq1_lut_buffer & lut,
+        const int slot,
+        const int packed) {
+    const int upper = (packed * 57) >> 9;
+    const int lower = packed - 9 * upper;
+    return lut.l2[slot][lower] + lut.l3[slot][upper];
+}
+
+template <int GROUPS_PER_CHUNK, int FIXED_CHUNKS = 0, int FIXED_GROUPS = 0>
+__global__ __launch_bounds__(TQ1_M_TILE, 5) void tq1_lut23_streamk(
+        const uint8_t * __restrict__ codes,
+        const half * __restrict__ scales,
+        const block_q8_1 * __restrict__ activation,
+        float * __restrict__ output,
+        float * __restrict__ workspace,
+        unsigned int * __restrict__ tile_counters,
+        const int rows,
+        const int groups_per_row,
+        const int chunks_per_row) {
+    __shared__ tq1_lut_buffer lut[2];
+    __shared__ int final_chunk;
+
+    const int tid = threadIdx.x;
+    const int groups = FIXED_GROUPS > 0 ? FIXED_GROUPS : groups_per_row;
+    const int chunks = FIXED_CHUNKS > 0 ? FIXED_CHUNKS : chunks_per_row;
+    const int tile = blockIdx.x / chunks;
+    const int chunk = blockIdx.x - tile * chunks;
+    const int row = tile * TQ1_M_TILE + tid;
+    const int first_group = chunk * GROUPS_PER_CHUNK;
+    const int final_group = min(first_group + GROUPS_PER_CHUNK, groups);
+    const int lane = tid & 31;
+    const int lane_div3 = lane / 3;
+    const float trit0 = static_cast<float>(lane - 3 * lane_div3 - 1);
+    const float trit1 = static_cast<float>(lane_div3 - 3 * (lane_div3 / 3) - 1);
+    const float trit2 = static_cast<float>(lane / 9 - 1);
+    float partial = 0.0f;
+
+    if (first_group < final_group) {
+        tq1_build_lut(activation, first_group, trit0, trit1, trit2, lut[0]);
+
+        for (int group = first_group; group < final_group; ++group) {
+            const int local_group = group - first_group;
+            const tq1_lut_buffer & current = lut[local_group & 1];
+            const std::size_t group_code_base =
+                (static_cast<std::size_t>(tile) * groups + group) *
+                TQ1_CODE_SLOTS * TQ1_M_TILE + tid;
+            float group_sum = 0.0f;
+#pragma unroll
+            for (int batch = 0; batch < TQ1_FULL_SLOTS / 5; ++batch) {
+                const int first_slot = batch * 5;
+                const int packed0 = codes[group_code_base + (first_slot + 0) * TQ1_M_TILE];
+                const int packed1 = codes[group_code_base + (first_slot + 1) * TQ1_M_TILE];
+                const int packed2 = codes[group_code_base + (first_slot + 2) * TQ1_M_TILE];
+                const int packed3 = codes[group_code_base + (first_slot + 3) * TQ1_M_TILE];
+                const int packed4 = codes[group_code_base + (first_slot + 4) * TQ1_M_TILE];
+                group_sum += tq1_consume_code(current, first_slot + 0, packed0);
+                group_sum += tq1_consume_code(current, first_slot + 1, packed1);
+                group_sum += tq1_consume_code(current, first_slot + 2, packed2);
+                group_sum += tq1_consume_code(current, first_slot + 3, packed3);
+                group_sum += tq1_consume_code(current, first_slot + 4, packed4);
+            }
+            const int tail_code = codes[group_code_base + 25 * TQ1_M_TILE];
+            group_sum += current.tail[tail_code];
+            const std::size_t scale_index =
+                (static_cast<std::size_t>(tile) * groups + group) * TQ1_M_TILE + tid;
+            partial = fmaf(__half2float(scales[scale_index]), group_sum, partial);
+
+            const int next_group = group + 1;
+            if (next_group < final_group) {
+                tq1_build_lut(
+                    activation, next_group, trit0, trit1, trit2,
+                    lut[(local_group + 1) & 1]);
+            }
+        }
+    }
+
+    const std::size_t workspace_index =
+        (static_cast<std::size_t>(tile) * chunks + chunk) * TQ1_M_TILE + tid;
+    workspace[workspace_index] = partial;
+    __threadfence();
+    __syncthreads();
+    if (tid == 0) {
+        final_chunk = atomicAdd(&tile_counters[tile], 1u) ==
+            static_cast<unsigned int>(chunks - 1);
+    }
+    __syncthreads();
+    if (final_chunk) {
+        float result = 0.0f;
+        if constexpr (FIXED_CHUNKS > 0) {
+#pragma unroll
+            for (int index = 0; index < FIXED_CHUNKS; ++index) {
+                result += workspace[
+                    (static_cast<std::size_t>(tile) * FIXED_CHUNKS + index) *
+                    TQ1_M_TILE + tid];
+            }
+        } else {
+            for (int index = 0; index < chunks; ++index) {
+                result += workspace[
+                    (static_cast<std::size_t>(tile) * chunks + index) *
+                    TQ1_M_TILE + tid];
+            }
+        }
+        if (row < rows) {
+            output[row] = result;
+        }
+        __syncthreads();
+        if (tid == 0) {
+            atomicExch(&tile_counters[tile], 0u);
+        }
+    }
+}
+
+void tq1_launch(
+        const uint8_t * codes,
+        const half * scales,
+        const block_q8_1 * activation,
+        float * output,
+        float * workspace,
+        unsigned int * counters,
+        int rows,
+        int columns,
+        cudaStream_t stream) {
+    GGML_ASSERT(columns % QK_TQ1_G128 == 0);
+    const int groups = columns / QK_TQ1_G128;
+    const int tiles = (rows + TQ1_M_TILE - 1) / TQ1_M_TILE;
+    const int chunks = (columns + TQ1_K_CHUNK - 1) / TQ1_K_CHUNK;
+
+    if (groups == 136 && chunks == 34) {
+        tq1_lut23_streamk<4, 34, 136><<<tiles * 34, TQ1_M_TILE, 0, stream>>>(
+            codes, scales, activation, output, workspace, counters,
+            rows, 136, 34);
+        return;
+    }
+    tq1_lut23_streamk<4><<<tiles * chunks, TQ1_M_TILE, 0, stream>>>(
+        codes, scales, activation, output, workspace, counters,
+        rows, groups, chunks);
+}
+
+} // namespace
+
+std::size_t ggml_cuda_tq1_g128_storage_size(int64_t columns, int64_t rows) {
+    GGML_ASSERT(columns > 0 && rows > 0 && columns % QK_TQ1_G128 == 0);
+    const std::size_t groups = columns / QK_TQ1_G128;
+    const std::size_t padded_rows = ((rows + TQ1_M_TILE - 1) / TQ1_M_TILE) * TQ1_M_TILE;
+    return padded_rows * groups * sizeof(block_tq1_g128);
+}
+
+void ggml_cuda_mul_mat_tq1_g128(
+        ggml_backend_cuda_context & ctx,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        ggml_tensor * dst) {
+    GGML_ASSERT(src0->type == GGML_TYPE_TQ1_G128);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1);
+    GGML_ASSERT(src0->ne[0] == src1->ne[0]);
+    GGML_ASSERT(src0->ne[0] % QK_TQ1_G128 == 0);
+
+    const int64_t columns = src0->ne[0];
+    const int64_t rows = src0->ne[1];
+    const int64_t columns_padded = GGML_PAD(columns, MATRIX_ROW_PADDING);
+    const int64_t vectors = src1->ne[1] * src1->ne[2] * src1->ne[3];
+    const std::size_t q8_blocks_per_vector = columns_padded / QK8_1;
+    cudaStream_t stream = ctx.stream();
+
+    ggml_cuda_pool_alloc<block_q8_1> activations(
+        ctx.pool(), vectors * q8_blocks_per_vector);
+    quantize_row_q8_1_cuda(
+        (const float *) src1->data, nullptr, activations.get(), GGML_TYPE_Q2_0,
+        src1->ne[0], src1->nb[1] / sizeof(float),
+        src1->nb[2] / sizeof(float), src1->nb[3] / sizeof(float),
+        columns_padded, src1->ne[1], src1->ne[2], src1->ne[3], stream);
+
+    const std::size_t groups = columns / QK_TQ1_G128;
+    const std::size_t padded_rows = ((rows + TQ1_M_TILE - 1) / TQ1_M_TILE) * TQ1_M_TILE;
+    const std::size_t code_bytes = padded_rows * groups * TQ1_CODE_SLOTS;
+    const uint8_t * codes = (const uint8_t *) src0->data;
+    const half * scales = (const half *) (codes + code_bytes);
+
+    const std::size_t tiles = padded_rows / TQ1_M_TILE;
+    const std::size_t chunks = (columns + TQ1_K_CHUNK - 1) / TQ1_K_CHUNK;
+    ggml_cuda_pool_alloc<float> workspace(
+        ctx.pool(), tiles * chunks * TQ1_M_TILE);
+    ggml_cuda_pool_alloc<unsigned int> counters(ctx.pool(), tiles);
+    CUDA_CHECK(cudaMemsetAsync(counters.get(), 0, tiles * sizeof(unsigned int), stream));
+
+    for (int64_t i13 = 0; i13 < src1->ne[3]; ++i13) {
+        for (int64_t i12 = 0; i12 < src1->ne[2]; ++i12) {
+            for (int64_t i11 = 0; i11 < src1->ne[1]; ++i11) {
+                const int64_t vector_index =
+                    (i13 * src1->ne[2] + i12) * src1->ne[1] + i11;
+                const block_q8_1 * activation =
+                    activations.get() + vector_index * q8_blocks_per_vector;
+                float * output = (float *) ((char *) dst->data +
+                    i11 * dst->nb[1] + i12 * dst->nb[2] + i13 * dst->nb[3]);
+                tq1_launch(
+                    codes, scales, activation, output, workspace.get(), counters.get(),
+                    rows, columns, stream);
+            }
+        }
+    }
+}
